# Application
APP_ENV=development
APP_NAME=ScholarSync
SECRET_KEY=replace-with-at-least-32-char-random-secret-key
# On Render, DATABASE_URL is injected automatically by Render PostgreSQL (postgresql://... is normalized automatically)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scholarsync

# CORS / Origin security (comma-separated origins; same-origin works automatically when FastAPI serves frontend)
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1

# Gemini AI (optional — core discovery, rules engine, checklist, and tracking work without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Official source collector, live web discovery & sync
SYNC_ON_STARTUP=false
ALLOW_LIVE_WEB_DISCOVERY=true
COLLECTOR_USER_AGENT=ScholarSync-OfficialSourceVerifier/1.0 (+https://scholarsync.local/about)
COLLECTOR_TIMEOUT_SECONDS=15
WEB_DISCOVERY_TIMEOUT_SECONDS=8

# Admin bootstrap (optional — creates initial admin only if zero admins exist; never hardcode defaults)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_FULL_NAME=ScholarSync Admin
